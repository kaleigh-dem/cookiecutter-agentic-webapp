{
  "name": "@agentic-webapp/source",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=25 <26",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "nx run-many -t dev serve --parallel=3",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "sync:check": "nx sync:check",
    "check": "pnpm sync:check && pnpm contracts:check && pnpm contracts:compat && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "affected": "nx affected -t lint typecheck test build",
    "graph": "nx graph",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "generate:domain": "nx g @agentic-webapp/workspace-plugin:domain",
    "generate:feature": "nx g @agentic-webapp/workspace-plugin:feature",
    "generate:job": "nx g @agentic-webapp/workspace-plugin:job",
    "generate:contract": "nx g @agentic-webapp/workspace-plugin:contract",
    "contracts:generate": "nx run contracts:generate",
    "contracts:check": "nx run contracts:generate-check",
    "contracts:compat": "nx run contracts:compatibility",
    "db:migration:create": "nx run database:migration-create",
    "db:migrate": "nx run database:migrate",
    "db:rollback": "nx run database:rollback",
    "db:status": "nx run database:status",
    "db:seed": "nx run database:seed",
    "db:reset": "nx run database:reset",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "telemetry:up": "docker compose --profile telemetry up -d otel-collector",
    "telemetry:logs": "docker compose logs -f otel-collector",
    "telemetry:down": "docker compose --profile telemetry stop otel-collector",
    "telemetry:check": "docker compose --profile telemetry config --quiet"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "next": "~16.2.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@agentic-webapp/workspace-plugin": "workspace:*",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "23.1.0",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "23.1.0",
    "@nx/next": "23.1.0",
    "@nx/node": "23.1.0",
    "@nx/react": "23.1.0",
    "@nx/workspace": "23.1.0",
    "@playwright/test": "^1.62.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "nx": "23.1.0",
    "prettier": "~3.6.2",
    "tsx": "^4.20.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  }
}
