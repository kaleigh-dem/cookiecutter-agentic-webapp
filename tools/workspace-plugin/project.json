{
  "name": "workspace-plugin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "tools/workspace-plugin",
  "sourceRoot": "tools/workspace-plugin/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:tooling", "runtime:node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/tools/workspace-plugin"],
      "options": {
        "command": "tsc -p tools/workspace-plugin/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tools/workspace-plugin/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint tools/workspace-plugin"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run tools/workspace-plugin/src"
      }
    },
    "generated-output-smoke": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx tools/workspace-plugin/src/generators/generated-output.integration.ts"
      }
    }
  }
}
