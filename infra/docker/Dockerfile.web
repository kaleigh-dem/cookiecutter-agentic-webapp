ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS dependencies
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
ARG NEXT_PUBLIC_AUTHENTICATION_PROFILE
ARG NEXT_PUBLIC_AUTH_SESSION_ENDPOINT=
ARG NEXT_PUBLIC_AUTH_SESSION_REFRESH_SKEW_SECONDS=30
WORKDIR /workspace
ENV NEXT_PUBLIC_API_BASE_URL=${NEXT_PUBLIC_API_BASE_URL} \
    NEXT_PUBLIC_AUTHENTICATION_PROFILE=${NEXT_PUBLIC_AUTHENTICATION_PROFILE} \
    NEXT_PUBLIC_AUTH_SESSION_ENDPOINT=${NEXT_PUBLIC_AUTH_SESSION_ENDPOINT} \
    NEXT_PUBLIC_AUTH_SESSION_REFRESH_SKEW_SECONDS=${NEXT_PUBLIC_AUTH_SESSION_REFRESH_SKEW_SECONDS} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm install --global pnpm@10.13.1

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml nx.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools

RUN pnpm install --frozen-lockfile

FROM dependencies AS preview
ENV HOSTNAME=0.0.0.0 \
    NODE_ENV=development \
    PORT=3000
RUN chown -R node:node /workspace
USER node
EXPOSE 3000
CMD ["pnpm", "exec", "next", "dev", "apps/web", "--hostname", "0.0.0.0", "--port", "3000"]

FROM dependencies AS build
ENV NODE_ENV=production
RUN pnpm nx run web:build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ARG APP_VERSION=development
ARG VCS_REF=unknown

LABEL org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.source="https://github.com/kaleigh-dem/nx-fullstack-platform"

ENV HOSTNAME=0.0.0.0 \
    NODE_ENV=production \
    PORT=3000
WORKDIR /app

COPY --from=build --chown=node:node /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /workspace/apps/web/.next/static ./apps/web/.next/static

USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
