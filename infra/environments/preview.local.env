DEPLOYMENT_ENVIRONMENT=preview
APP_VERSION=0.1.0-preview.1
NODE_ENV=production
API_NODE_ENV=development
API_PORT=4000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTHENTICATION_PROFILE=development
NEXT_PUBLIC_AUTH_SESSION_ENDPOINT=
NEXT_PUBLIC_AUTH_SESSION_REFRESH_SKEW_SECONDS=30
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
WORKER_BASE_URL=http://localhost:4001
SMOKE_TEST_PROFILE=live-agent-task
API_RATE_LIMIT_STORE=memory
API_RATE_LIMIT_ANONYMOUS_MAX=60
API_RATE_LIMIT_AUTHENTICATED_MAX=120
API_RATE_LIMIT_ROUTE_MAX=60
API_RATE_LIMIT_TENANT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_BUCKETS=10000
API_TRUSTED_PROXY_HOPS=0
AUTH_ACCESS_TOKEN_VERIFIER=development
AUTH_DEVELOPMENT_TOKEN=local-development-token
AUTH_DEVELOPMENT_SUBJECT=preview-operator
AUTH_DEVELOPMENT_TENANT=preview-tenant
AUTH_DEVELOPMENT_PERMISSIONS=agent-tasks:read,agent-tasks:write
AUTH_SESSION_COOKIE_NAME=agentic_access_token
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_VERSION=0.1.0-preview.1
API_IMAGE=agentic-webapp-api:local
WORKER_IMAGE=agentic-webapp-worker:local
WEB_IMAGE=agentic-webapp-web:local
WEB_IMAGE_TARGET=preview
POSTGRES_PASSWORD=postgres
