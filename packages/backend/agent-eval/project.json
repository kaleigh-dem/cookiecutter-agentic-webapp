{
  "name": "backend-agent-eval",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/backend/agent-eval/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:util", "runtime:node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/backend/agent-eval"],
      "options": {
        "command": "tsc -p packages/backend/agent-eval/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/backend/agent-eval/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/backend/agent-eval"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/backend/agent-eval/src --passWithNoTests"
      }
    },
    "evidence-check": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "tsx packages/backend/agent-eval/src/bin/check-evidence.ts"
      }
    }
  }
}
