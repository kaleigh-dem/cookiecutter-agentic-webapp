{
  "name": "backend-agent-tool",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/backend/agent-tool/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:util", "runtime:node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/backend/agent-tool"],
      "options": {
        "command": "tsc -p packages/backend/agent-tool/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/backend/agent-tool/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/backend/agent-tool"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/backend/agent-tool/src --passWithNoTests"
      }
    }
  }
}
