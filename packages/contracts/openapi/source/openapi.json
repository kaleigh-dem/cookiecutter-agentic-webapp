{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "SteadyStack API",
    "version": "0.3.0",
    "description": "The canonical HTTP contract for the API application."
  },
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development API"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Service health and readiness signals."
    },
    {
      "name": "agent-tasks",
      "description": "Authenticated actor-scoped tasks queued for agent execution."
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Read API health",
        "description": "Returns a stable public health response for the API process.",
        "tags": ["health"],
        "responses": {
          "200": {
            "description": "The API is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent-tasks": {
      "post": {
        "operationId": "createAgentTask",
        "summary": "Create an agent task",
        "tags": ["agent-tasks"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "$ref": "#/components/parameters/ActorId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentTaskRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The task was validated and queued.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentTaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "The request was invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent-tasks/{taskId}": {
      "get": {
        "operationId": "getAgentTask",
        "summary": "Read an owned agent task",
        "tags": ["agent-tasks"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/ActorId"
          },
          {
            "$ref": "#/components/parameters/CorrelationId"
          }
        ],
        "responses": {
          "200": {
            "description": "The owned task.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentTaskResponse"
                }
              }
            }
          },
          "403": {
            "description": "The task belongs to another actor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "The task does not exist.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "$ref": "./schemas/health-response.json"
      },
      "CreateAgentTaskRequest": {
        "$ref": "./schemas/create-agent-task-request.json"
      },
      "AgentTaskResponse": {
        "$ref": "./schemas/agent-task-response.json"
      },
      "ErrorResponse": {
        "$ref": "./schemas/error-response.json"
      }
    },
    "parameters": {
      "ActorId": {
        "name": "x-actor-id",
        "in": "header",
        "required": false,
        "deprecated": true,
        "description": "Deprecated compatibility header. The API ignores it; authenticated identity comes from the bearer token.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      "CorrelationId": {
        "name": "x-correlation-id",
        "in": "header",
        "required": false,
        "description": "Optional caller correlation identifier propagated into persistence and jobs.",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Provider-issued access token validated by the API authentication adapter."
      }
    }
  }
}
