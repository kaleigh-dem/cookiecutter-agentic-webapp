{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/contracts/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:contract", "runtime:universal"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/contracts"],
      "options": {
        "command": "tsc -p packages/contracts/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/contracts/tsconfig.lib.json --noEmit"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint packages/contracts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run packages/contracts/src packages/contracts/scripts"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/packages/contracts/openapi/generated/openapi.json",
        "{workspaceRoot}/packages/contracts/src/generated"
      ],
      "options": {
        "command": "tsx packages/contracts/scripts/generate.ts && prettier --write packages/contracts/openapi/generated/openapi.json packages/contracts/src/generated"
      }
    },
    "generate-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm nx run contracts:generate && git diff --exit-code -- packages/contracts/openapi/generated packages/contracts/src/generated"
      }
    },
    "compatibility": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx packages/contracts/scripts/check-compatibility.ts"
      }
    }
  }
}
