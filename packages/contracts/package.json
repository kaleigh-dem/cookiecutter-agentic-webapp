{
  "name": "@steadystack/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/generated/client.ts",
      "import": "./src/generated/client.ts",
      "default": "./src/generated/client.ts"
    },
    "./openapi": {
      "types": "./src/generated/openapi.ts",
      "import": "./src/generated/openapi.ts",
      "default": "./src/generated/openapi.ts"
    },
    "./openapi.json": "./openapi/generated/openapi.json",
    "./runtime": {
      "types": "./src/generated/runtime.ts",
      "import": "./src/generated/runtime.ts",
      "default": "./src/generated/runtime.ts"
    },
    "./server": {
      "types": "./src/generated/server.ts",
      "import": "./src/generated/server.ts",
      "default": "./src/generated/server.ts"
    }
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
