{
  "name": "env",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/env/src",
  "projectType": "library",
  "tags": ["scope:backend", "type:config", "runtime:node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/env"],
      "options": {
        "command": "tsc -p packages/env/tsconfig.lib.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p packages/env/tsconfig.lib.json --noEmit"
      }
    }
  }
}
