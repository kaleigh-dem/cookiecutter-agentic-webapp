{
  "name": "@steadystack/database",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./migrations": {
      "types": "./src/migrations.ts",
      "import": "./src/migrations.ts",
      "default": "./src/migrations.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "import": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    },
    "./seed": {
      "types": "./src/seed.ts",
      "import": "./src/seed.ts",
      "default": "./src/seed.ts"
    },
    "./status": {
      "types": "./src/status.ts",
      "import": "./src/status.ts",
      "default": "./src/status.ts"
    }
  },
  "dependencies": {
    "@steadystack/backend-agent-task": "workspace:*",
    "@steadystack/backend-rate-limit": "workspace:*",
    "@steadystack/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.0.4",
    "@types/pg": "8.20.2",
    "node-pg-migrate": "9.0.0"
  }
}
