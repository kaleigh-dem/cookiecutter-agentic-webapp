{
  "name": "worker",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/worker/src",
  "projectType": "application",
  "tags": ["scope:backend", "type:app", "runtime:node"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/worker",
        "main": "apps/worker/src/main.ts",
        "tsConfig": "apps/worker/tsconfig.app.json",
        "assets": []
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "worker:build",
        "runBuildTargetDependencies": false
      }
    },
    "container": {
      "executor": "nx:run-commands",
      "inputs": [
        "production",
        "^production",
        "containerCommonFiles",
        "imageMetadata",
        "{workspaceRoot}/infra/docker/Dockerfile.node-service",
        { "env": "WORKER_IMAGE" }
      ],
      "options": {
        "command": "node tools/delivery/build-container.mjs --scope worker --file infra/docker/Dockerfile.node-service --tag ${WORKER_IMAGE:-steadystack-worker:local} --build-arg SERVICE=worker --build-arg APP_VERSION=${APP_VERSION:-development} --build-arg VCS_REF=${GITHUB_SHA:-local} --build-arg RELEASE_RUN_ID=${GITHUB_RUN_ID:-local} --build-arg RELEASE_BUILD_INPUTS_SHA256=${RELEASE_BUILD_INPUTS_SHA256:-local}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/worker/tsconfig.app.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run apps/worker/src"
      }
    }
  }
}
