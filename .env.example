NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
REDIS_URL=redis://localhost:6379
LOG_LEVEL=debug

# Development-only authentication adapter. This token is intentionally public to
# the local browser bundle and must never be used in a production deployment.
AUTH_DEVELOPMENT_TOKEN=local-development-token
AUTH_DEVELOPMENT_SUBJECT=00000000-0000-4000-8000-000000000001
AUTH_DEVELOPMENT_PERMISSIONS=agent-tasks:read,agent-tasks:write,operations:read
NEXT_PUBLIC_AUTH_DEVELOPMENT_TOKEN=local-development-token
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW_MS=60000

# Leave these blank to keep telemetry disabled. Use http://localhost:4318
# after starting the optional local collector with `pnpm telemetry:up`.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=10000
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_OTEL_DEPLOYMENT_ENVIRONMENT=development
