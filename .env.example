NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AUTHENTICATION_PROFILE=development
NEXT_PUBLIC_AUTH_SESSION_ENDPOINT=
NEXT_PUBLIC_AUTH_SESSION_REFRESH_SKEW_SECONDS=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app
LOG_LEVEL=debug

# Development-only authentication adapters. Production web builds must select
# oidc, session, or none explicitly and cannot use local-development-token.
AUTH_ACCESS_TOKEN_VERIFIER=development
AUTH_DEVELOPMENT_TOKEN=local-development-token
AUTH_DEVELOPMENT_SUBJECT=00000000-0000-4000-8000-000000000001
AUTH_DEVELOPMENT_TENANT=local-tenant
AUTH_DEVELOPMENT_PERMISSIONS=agent-tasks:read,agent-tasks:write,operations:read
API_RATE_LIMIT_STORE=memory
API_RATE_LIMIT_ANONYMOUS_MAX=60
API_RATE_LIMIT_AUTHENTICATED_MAX=120
API_RATE_LIMIT_ROUTE_MAX=60
API_RATE_LIMIT_TENANT_MAX=1000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX_BUCKETS=10000
API_TRUSTED_PROXY_HOPS=0

# Leave these blank to keep telemetry disabled. Use http://localhost:4318
# after starting the optional local collector with `pnpm telemetry:up`.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_METRIC_EXPORT_INTERVAL=10000
OTEL_DEPLOYMENT_ENVIRONMENT=development
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_OTEL_DEPLOYMENT_ENVIRONMENT=development
